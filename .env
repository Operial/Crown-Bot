# Create new keys before running. Do not reuse keys that were shared in chat or uploaded.
DISCORD_TOKEN=
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
# Optional: set to a vision-capable model to analyse attached images.
# Example: llama3.2-vision:11b
OLLAMA_VISION_MODEL=gemma3:4b

# Used privately for official alliance/nation/leader identity and flag matching.
PNW_API_KEY=
PNW_GRAPHQL_URL=https://api.politicsandwar.com/graphql
PNW_REFRESH_SECONDS=21600
PNW_PAGE_SIZE=500

# The existing six channel IDs are built into the module. To override them,
# provide a comma-separated list here.
AI_SEARCH_CHANNEL_IDS=
AI_AUTO_CATCHUP=true
AI_HASH_MEDIA=true
AI_USE_QUERY_PLANNER=true
AI_MAX_MEDIA_PER_MESSAGE=2
